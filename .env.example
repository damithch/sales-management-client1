# Postgres connection string (Neon: use the pooled connection string)
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
# Long random string used to sign login sessions: openssl rand -hex 32
SESSION_SECRET=
# Currency code used to display money
CURRENCY=LKR
# Only read by `npm run db:setup` to create the Developer account
DEVELOPER_EMAIL=
DEVELOPER_PASSWORD=
